pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                echo 'Получение кода'
            }
        }

        stage('Build') {
            steps {
                echo 'Сборка проекта'
            }
        }

        stage('Test') {
            steps {
                echo 'Запуск тестов'
            }
        }

        stage('Deploy') {
            steps {
                echo 'Развертывание'
            }
        }
    }
}